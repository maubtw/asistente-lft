# LLM: API de OpenAI
# La app (API + web) NO usa esta clave: cada usuario escribe la suya en Ajustes y viaja en el
# encabezado X-OpenAI-Key. Esta solo la usan las herramientas de desarrollo: la evaluación
# (eval/run_eval.py) y el CLI (rag/pipeline.py). Puedes dejarla vacía si solo usas la app.
OPENAI_API_KEY=
LLM_MODEL=gpt-5-mini
# Modelo para el juez de la evaluación (fidelidad/corrección)
JUDGE_MODEL=gpt-5-mini
# Solo modelos de razonamiento (gpt-5*, o*): minimal | low | medium | high. Vacío para gpt-4.1 etc.
LLM_REASONING_EFFORT=low
# Reescritura de consulta (USE_QUERY_REWRITE): modelo y razonamiento propios. Vacío = LLM_MODEL.
REWRITE_MODEL=
REWRITE_REASONING_EFFORT=minimal

DATABASE_URL=postgresql://lft:lft@localhost:5432/lft

EMBEDDING_MODEL=BAAI/bge-m3
RERANKER_MODEL=BAAI/bge-reranker-v2-m3

# Flags del pipeline (para comparar en la evaluación)
CHUNKING_STRATEGY=by_article
USE_HYBRID=false
USE_RERANKER=false
USE_REFERENCE_EXPANSION=true
USE_QUERY_REWRITE=false
# Con qué consulta reordena el reranker si hay reescritura (medido: "max" > "rewrite" > "original")
RERANK_QUERY=max
TOP_K=5
